{
  "name": "ripjaw-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node --conditions=react-server scripts/check-export.ts",
    "serve": "node scripts/serve.ts --port 4173",
    "verify": "node --conditions=react-server scripts/verify.ts",
    "verify:this-build": "node --conditions=react-server scripts/verify.ts --this-build-only",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets": "node --conditions=react-server scripts/build-assets.ts",
    "capture": "node scripts/capture.ts"
  },
  "dependencies": {
    "lucide-react": "1.74.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "playwright-core": "1.65.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
